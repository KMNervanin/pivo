diff --git a/packages/tui/src/context/content-width.ts b/packages/tui/src/context/content-width.ts
new file mode 100644
index 0000000..a92bf6a
--- /dev/null
+++ b/packages/tui/src/context/content-width.ts
@@ -0,0 +1,26 @@
+import { createSignal } from "solid-js"
+import { useKV } from "./kv"
+
+const [preview, setPreview] = createSignal<number>()
+const key = "pivo_content_width"
+
+function percent(value: unknown) {
+  return typeof value === "number" && Number.isFinite(value) ? Math.max(40, Math.min(100, Math.round(value))) : 100
+}
+
+export function useContentWidth() {
+  const kv = useKV()
+  const value = () => preview() ?? percent(kv.get(key))
+  return {
+    value,
+    configured: () => preview() !== undefined || kv.get(key) !== undefined,
+    columns: (available: number) =>
+      Math.max(0, Math.min(available, Math.max(40, Math.floor((available * value()) / 100)))),
+    preview: (value: number) => setPreview(percent(value)),
+    save() {
+      const next = value()
+      if (kv.get(key) !== next) kv.set(key, next)
+      setPreview(undefined)
+    },
+  }
+}
