diff --git a/packages/tui/src/util/agent-duration.ts b/packages/tui/src/util/agent-duration.ts
new file mode 100644
index 0000000..18ba5c5
--- /dev/null
+++ b/packages/tui/src/util/agent-duration.ts
@@ -0,0 +1,24 @@
+import type { Message, SessionStatus } from "@opencode-ai/sdk/v2"
+
+export function agentRun(messages: Message[], status?: SessionStatus) {
+  const last = messages.findLast((message) => message.role === "assistant")
+  if (!last || last.role !== "assistant") return undefined
+  const first = messages.find((message) => message.role === "assistant" && message.parentID === last.parentID)!
+  const finished = Boolean(
+    last.time.completed && (last.error || (last.finish && !["tool-calls", "unknown"].includes(last.finish))),
+  )
+  return {
+    start: first.time.created,
+    end: last.time.completed,
+    running: status !== undefined && status.type !== "idle" && !finished,
+    finished,
+    failed: Boolean(last.error),
+  }
+}
+
+export function agentDuration(milliseconds: number) {
+  const seconds = Math.max(0, Math.floor(milliseconds / 1000))
+  const minutes = Math.floor(seconds / 60)
+  if (minutes < 60) return `${minutes}:${String(seconds % 60).padStart(2, "0")}`
+  return `${Math.floor(minutes / 60)}:${String(minutes % 60).padStart(2, "0")}:${String(seconds % 60).padStart(2, "0")}`
+}
diff --git a/packages/tui/src/util/important-tools.ts b/packages/tui/src/util/important-tools.ts
new file mode 100644
index 0000000..816965c
--- /dev/null
+++ b/packages/tui/src/util/important-tools.ts
@@ -0,0 +1,53 @@
+import type { ToolPart } from "@opencode-ai/sdk/v2"
+
+const quiet = new Set(["read", "glob", "grep", "list", "webfetch", "websearch", "skill", "todowrite", "todoread"])
+
+export function importantTool(part: ToolPart): boolean {
+  if (toolFailed(part)) return true
+  const calls = part.state.status === "pending" ? undefined : part.state.metadata?.toolCalls
+  if (part.tool === "execute" && Array.isArray(calls) && calls.length > 0)
+    return calls.some((call) => !call || typeof call.tool !== "string" || !routineTool(call.tool))
+  return !routineTool(part.tool)
+}
+
+export function toolFailed(part: ToolPart): boolean {
+  if (part.state.status === "error") return true
+  if (part.state.status === "pending") return false
+  if (part.state.metadata?.error === true) return true
+  const calls = part.state.metadata?.toolCalls
+  return Array.isArray(calls) && calls.some((call) => call?.status === "error")
+}
+
+function routineTool(tool: string): boolean {
+  const name = tool.replace(/^functions\./, "")
+  if (quiet.has(name)) return true
+  if (/^(?:context7|openaiDeveloperDocs)[_.]/.test(name)) return true
+  if (
+    /^(?:github|gitlab)_(?:get_|list_|search_|whoami$|health_check$|my_issues$|mr_discussions$|validate_|verify_)/.test(
+      name,
+    )
+  )
+    return true
+  if (/^github_(?:issue|pull_request)_read$/.test(name)) return true
+  if (/^(?:confluence_confluence|jira_jira)_(?:get_|search_)/.test(name)) return true
+  if (/^(?:bridge4simulator_ui_|XcodeBuildMCP_(?:snapshot_ui|wait_for_ui|get_|list_|show_))/.test(name)) return true
+  // Unknown tools may mutate external state; only known read-only calls are hidden.
+  return false
+}
+
+export function importantToolLabel(part: ToolPart) {
+  const input = part.state.input
+  const title = part.state.status === "completed" || part.state.status === "running" ? part.state.title : undefined
+  const detail = input.description ?? input.command ?? input.filePath ?? input.file_path ?? input.path ?? title
+  const text = typeof detail === "string" ? detail.replace(/\s+/g, " ").trim() : ""
+  const calls = part.state.status === "pending" ? undefined : part.state.metadata?.toolCalls
+  const children =
+    part.tool === "execute" && Array.isArray(calls)
+      ? calls
+          .filter((call) => typeof call?.tool === "string" && (call.status === "error" || !routineTool(call.tool)))
+          .map((call) => call.tool)
+          .join(", ")
+      : ""
+  const label = `${toolFailed(part) ? "Ошибка · " : ""}${children || (text ? `${part.tool} · ${text}` : part.tool)}`
+  return label.length > 120 ? label.slice(0, 119) + "…" : label
+}
diff --git a/packages/tui/src/util/subscription-usage.ts b/packages/tui/src/util/subscription-usage.ts
new file mode 100644
index 0000000..2901a79
--- /dev/null
+++ b/packages/tui/src/util/subscription-usage.ts
@@ -0,0 +1,73 @@
+import { Schema } from "effect"
+import { Global } from "@opencode-ai/core/global"
+import path from "path"
+
+const Window = Schema.Struct({
+  used_percent: Schema.Number,
+  limit_window_seconds: Schema.Number,
+  reset_at: Schema.optional(Schema.Number),
+  reset_after_seconds: Schema.optional(Schema.Number),
+})
+
+const Usage = Schema.Struct({
+  plan_type: Schema.optional(Schema.String),
+  rate_limit: Schema.NullOr(
+    Schema.Struct({
+      primary_window: Schema.optional(Schema.NullOr(Window)),
+      secondary_window: Schema.optional(Schema.NullOr(Window)),
+    }),
+  ),
+})
+
+const Credentials = Schema.Struct({
+  type: Schema.Literal("oauth"),
+  access: Schema.String,
+  expires: Schema.Number,
+  accountId: Schema.optional(Schema.String),
+})
+
+export function parseSubscriptionUsage(input: unknown, now = Date.now()) {
+  const data = Schema.decodeUnknownSync(Usage)(input)
+  const windows = [data.rate_limit?.primary_window, data.rate_limit?.secondary_window].flatMap((window) => {
+    if (!window || !Number.isFinite(window.used_percent) || window.used_percent < 0 || window.used_percent > 100)
+      return []
+    const label =
+      window.limit_window_seconds === 604800 ? "Неделя" : window.limit_window_seconds === 18000 ? "5 часов" : undefined
+    if (!label) return []
+    const reset =
+      window.reset_at ??
+      (window.reset_after_seconds === undefined ? undefined : now / 1000 + window.reset_after_seconds)
+    return [
+      {
+        label,
+        remaining: 100 - window.used_percent,
+        reset: reset && Number.isFinite(reset) ? reset * 1000 : undefined,
+      },
+    ]
+  })
+  return { plan: data.plan_type, windows }
+}
+
+export async function subscriptionUsage(signal: AbortSignal) {
+  const raw = process.env.OPENCODE_AUTH_CONTENT
+    ? JSON.parse(process.env.OPENCODE_AUTH_CONTENT)
+    : await Bun.file(path.join(Global.Path.data, "auth.json"))
+        .json()
+        .catch(() => ({}))
+  const auth = Schema.decodeUnknownOption(Credentials)(raw.openai)
+  if (auth._tag === "None") throw new Error("Нет входа в ChatGPT. Подключи OpenAI через /connect.")
+  if (auth.value.expires <= Date.now())
+    throw new Error(
+      "Вход в ChatGPT истёк. Отправь сообщение модели OpenAI для обновления входа или используй /connect, затем повтори /usage.",
+    )
+  const headers: Record<string, string> = { Authorization: `Bearer ${auth.value.access}` }
+  if (auth.value.accountId) headers["ChatGPT-Account-Id"] = auth.value.accountId
+  const response = await fetch("https://chatgpt.com/backend-api/wham/usage", {
+    headers,
+    redirect: "error",
+    signal: AbortSignal.any([signal, AbortSignal.timeout(15000)]),
+  })
+  if (!response.ok)
+    throw new Error(`ChatGPT вернул HTTP ${response.status}. Попробуй позже или обнови вход через /connect.`)
+  return parseSubscriptionUsage(await response.json())
+}
