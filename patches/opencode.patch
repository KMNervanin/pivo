@@ -0,0 +1,47 @@
+import { describe, expect, test } from "bun:test"
+import { parseSubscriptionUsage } from "../../../src/util/subscription-usage"
+
+describe("subscription quota", () => {
+  test("identifies the week by duration, not primary/secondary position", () => {
+    const usage = parseSubscriptionUsage(
+      {
+        plan_type: "pro",
+        rate_limit: {
+          primary_window: { used_percent: 37, limit_window_seconds: 604800, reset_at: 1800000000 },
+          secondary_window: { used_percent: 8, limit_window_seconds: 18000, reset_after_seconds: 120 },
+        },
+      },
+      1000000,
+    )
+    expect(usage.windows).toEqual([
+      { label: "Неделя", remaining: 63, reset: 1800000000000 },
+      { label: "5 часов", remaining: 92, reset: 1120000 },
+    ])
+  })
+
+  test("missing windows never imply a full allowance", () => {
+    expect(parseSubscriptionUsage({ rate_limit: null }).windows).toEqual([])
+    expect(parseSubscriptionUsage({ rate_limit: { primary_window: null } }).windows).toEqual([])
+  })
+
+  test("unknown periods and invalid percentages are not presented as weekly quota", () => {
+    expect(
+      parseSubscriptionUsage({
+        rate_limit: {
+          primary_window: { used_percent: 10, limit_window_seconds: 3600 },
+          secondary_window: { used_percent: -1, limit_window_seconds: 604800 },
+        },
+      }).windows,
+    ).toEqual([])
+  })
+
+  test("exhausted quota is zero remaining", () => {
+    expect(
+      parseSubscriptionUsage({
+        rate_limit: {
+          primary_window: { used_percent: 100, limit_window_seconds: 604800 },
+        },
+      }).windows[0]?.remaining,
+    ).toBe(0)
+  })
+})
diff --git a/packages/tui/test/fixture/pivo-render-check.tsx b/packages/tui/test/fixture/pivo-render-check.tsx
new file mode 100644
index 0000000..f4f2b34
--- /dev/null
+++ b/packages/tui/test/fixture/pivo-render-check.tsx
@@ -0,0 +1,553 @@
+import { expect, mock } from "bun:test"
+import type { TuiPluginApi } from "@opencode-ai/plugin/tui"
+import type { ToolPart } from "@opencode-ai/sdk/v2"
+import { createTestRenderer } from "@opentui/core/testing"
+import { Effect } from "effect"
+import { Global } from "@opencode-ai/core/global"
+import { createTuiResolvedConfig } from "./tui-runtime"
+import { createEventSource, createFetch, directory, json } from "./tui-sdk"
+import { tmpdir } from "./fixture"
+
+async function check() {
+  await using tmp = await tmpdir()
+  await Bun.write(
+    `${tmp.path}/kv.json`,
+    JSON.stringify({ thinking_mode: "show", thinking_visibility: true, paste_summary_enabled: false }),
+  )
+  const setup = await createTestRenderer({ width: 100, height: 40, useThread: false, kittyKeyboard: true })
+  const core = await import("@opentui/core")
+  await mock.module("@opentui/core", () => ({ ...core, createCliRenderer: async () => setup.renderer }))
+  const sessionID = "ses_pivo_test"
+  const messageID = "msg_pivo_assistant"
+  const session = {
+    id: sessionID,
+    title: "pivo render check",
+    slug: "pivo",
+    projectID: "proj_test",
+    directory,
+    version: "1.18.34",
+    time: { created: 1, updated: 2 },
+  }
+  const message = {
+    id: messageID,
+    sessionID,
+    role: "assistant" as const,
+    agent: "build",
+    mode: "build",
+    providerID: "test",
+    modelID: "test",
+    parentID: "msg_pivo_user",
+    path: { cwd: directory, root: directory },
+    cost: 0,
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    time: { created: 1 },
+  }
+  const parts = [
+    { id: "prt_a", sessionID, messageID, type: "text" as const, text: "VISIBLE BEFORE" },
+    {
+      id: "prt_b",
+      sessionID,
+      messageID,
+      type: "reasoning" as const,
+      text: "**HIDDEN OLD THOUGHT**\n\nReasoning body",
+      time: { start: 1, end: 2 },
+    },
+    {
+      id: "prt_c",
+      sessionID,
+      messageID,
+      type: "reasoning" as const,
+      text: "**HIDDEN LIVE THOUGHT**\n\nStreaming body",
+      time: { start: 3 },
+    },
+    { id: "prt_d", sessionID, messageID, type: "text" as const, text: "VISIBLE AFTER" },
+  ]
+  const history = Array.from({ length: process.env.PIVO_HISTORY_CHECK ? 120 : 0 }, (_, index) => {
+    const id = `msg_000_history_${String(index).padStart(4, "0")}`
+    return {
+      info: {
+        id,
+        sessionID,
+        role: "user",
+        agent: "build",
+        model: { providerID: "test", modelID: "test" },
+        time: { created: 0 },
+      },
+      parts: [
+        {
+          id: `prt_history_${index}`,
+          sessionID,
+          messageID: id,
+          type: "text",
+          text: index === 0 ? "BEGINNING OF COMPLETE HISTORY" : `Earlier message ${index}`,
+        },
+      ],
+    }
+  })
+  const events = createEventSource()
+  let steerRequests = 0
+  let releaseSteer: (response: Response) => void = () => {}
+  const steerResponse = new Promise<Response>((resolve) => {
+    releaseSteer = resolve
+  })
+  const calls = createFetch((url) => {
+    if (url.pathname === `/session/${sessionID}/children`)
+      return json([{ ...session, id: "ses_child", parentID: sessionID, title: "Inspect code (@reader subagent)" }])
+    if (url.pathname === "/session/ses_child/message")
+      return json([{ info: { ...message, sessionID: "ses_child", time: { created: 1, completed: 2 } }, parts: [] }])
+    if (url.pathname === `/session/${sessionID}/steer`) {
+      steerRequests++
+      return steerResponse
+    }
+    if (url.pathname === "/config/providers")
+      return json({
+        providers: [
+          {
+            id: "test",
+            name: "Test",
+            env: [],
+            models: {
+              test: {
+                id: "test",
+                name: "Test",
+                providerID: "test",
+                api: { id: "test", npm: "@ai-sdk/openai", url: "http://test" },
+                limit: { context: 10000, output: 1000 },
+                cost: { input: 0, output: 0 },
+                capabilities: { input: {}, output: {} },
+                variants: {},
+              },
+            },
+          },
+        ],
+        default: { test: "test" },
+      })
+    if (url.pathname === "/provider")
+      return json({
+        all: [
+          {
+            id: "test",
+            name: "Test",
+            env: [],
+            models: {
+              test: {
+                id: "test",
+                name: "Test",
+                providerID: "test",
+                api: { id: "test", npm: "@ai-sdk/openai", url: "http://test" },
+                limit: { context: 10000, output: 1000 },
+                cost: { input: 0, output: 0 },
+                capabilities: { input: {}, output: {} },
+                variants: {},
+              },
+            },
+          },
+        ],
+        default: { test: "test" },
+        connected: ["test"],
+      })
+    if (url.pathname === "/session") return json([session])
+    if (url.pathname === `/session/${sessionID}`) return json(session)
+    if (url.pathname === `/session/${sessionID}/message`) {
+      const messages = [...history, { info: message, parts }]
+      const limit = url.searchParams.get("limit")
+      return json(limit ? messages.slice(-Number(limit)) : messages)
+    }
+    if (url.pathname === `/session/${sessionID}/todo` || url.pathname === `/session/${sessionID}/diff`) return json([])
+    if (url.pathname === "/session/status") return json({ [sessionID]: { type: "busy" } })
+    if (url.pathname === "/agent")
+      return json([
+        { name: "build", mode: "primary", options: {}, permission: [] },
+        { name: "reader", description: "Read-only researcher", mode: "subagent", options: {}, permission: [] },
+      ])
+    return undefined
+  })
+  const launches: unknown[] = []
+  const fetch = Object.assign(
+    async (input: RequestInfo | URL, init?: RequestInit) => {
+      const request = input instanceof Request ? input : new Request(input, init)
+      if (new URL(request.url).pathname === `/session/${sessionID}/prompt_async`) {
+        launches.push(await request.json())
+        return new Response(null, { status: 204 })
+      }
+      return calls.fetch(request)
+    },
+    { preconnect: globalThis.fetch.preconnect },
+  )
+  let api: TuiPluginApi | undefined
+  let disposeSlots: (() => void) | undefined
+  const frame = async () => {
+    await setup.renderOnce()
+    return setup.captureCharFrame()
+  }
+  const wait = async (condition: (text: string) => boolean) => {
+    for (let i = 0; i < 200; i++) {
+      const text = await frame()
+      if (condition(text)) return text
+      await Bun.sleep(10)
+    }
+    throw new Error(`Frame condition not met:\n${await frame()}`)
+  }
+  const assertInputVisible = () => {
+    const input = setup.renderer.root.findDescendantById("pivo-session-input")!
+    const column = setup.renderer.root.findDescendantById("pivo-chat-column")!
+    expect(input.height).toBeGreaterThanOrEqual(5)
+    expect(input.y).toBeGreaterThanOrEqual(0)
+    expect(
+      input.y + input.height,
+      `Input y=${input.y}, height=${input.height}; column y=${column.y}, height=${column.height}; terminal height=${setup.renderer.terminalHeight}`,
+    ).toBeLessThanOrEqual(setup.renderer.terminalHeight)
+  }
+  try {
+    const { run } = await import("../../src/app")
+    const task = Effect.runPromise(
+      run({
+        url: "http://test",
+        directory,
+        config: createTuiResolvedConfig({ plugin_enabled: {} }),
+        fetch,
+        events: events.source,
+        args: { sessionID },
+        pluginHost: {
+          async start(input) {
+            api = input.api
+            const slots = input.runtime.setupSlots(input.api)
+            disposeSlots = () => slots.dispose()
+          },
+          async dispose() {
+            disposeSlots?.()
+          },
+        },
+      }).pipe(Effect.provide(Global.layerWith({ state: tmp.path }))),
+    )
+    const hidden = await wait((text) => text.includes("VISIBLE AFTER"))
+    await wait(() => (setup.renderer.root.findDescendantById("pivo-session-input")?.height ?? 0) >= 5)
+    assertInputVisible()
+    if (process.env.PIVO_HISTORY_CHECK) {
+      api!.keymap.dispatchCommand("session.first")
+      await wait((text) => text.includes("BEGINNING OF COMPLETE HISTORY"))
+      for (let index = 0; index < 120; index++) {
+        const id = `msg_z_live_${String(index).padStart(4, "0")}`
+        events.emit({
+          directory,
+          payload: {
+            id: `evt_live_message_${index}`,
+            type: "message.updated",
+            properties: {
+              sessionID,
+              info: {
+                ...message,
+                id,
+                parentID: "msg_pivo_queued",
+                finish: "stop",
+                time: { created: 100 + index, completed: 101 + index },
+              },
+            },
+          },
+        })
+        events.emit({
+          directory,
+          payload: {
+            id: `evt_live_part_${index}`,
+            type: "message.part.updated",
+            properties: {
+              sessionID,
+              time: 100 + index,
+              part: {
+                id: `prt_z_live_${index}`,
+                sessionID,
+                messageID: id,
+                type: "text",
+                text: `New live reply ${index}`,
+              },
+            },
+          },
+        })
+      }
+      api!.keymap.dispatchCommand("session.last")
+      await wait((text) => text.includes("New live reply 119"))
+      api!.keymap.dispatchCommand("session.first")
+      await wait((text) => text.includes("BEGINNING OF COMPLETE HISTORY"))
+      assertInputVisible()
+      api!.keymap.dispatchCommand("app.exit")
+      await task
+      return
+    }
+    expect(hidden).not.toContain("HIDDEN OLD THOUGHT")
+    expect(hidden).not.toContain("HIDDEN LIVE THOUGHT")
+    expect(hidden).not.toContain("Thought")
+    const lines = hidden.split("\n")
+    expect(
+      lines.findIndex((line) => line.includes("VISIBLE AFTER")) -
+        lines.findIndex((line) => line.includes("VISIBLE BEFORE")),
+    ).toBe(2)
+
+    api!.keymap.dispatchCommand("session.toggle.thinking")
+    await wait((text) => text.includes("HIDDEN OLD THOUGHT") && text.includes("HIDDEN LIVE THOUGHT"))
+    api!.keymap.dispatchCommand("session.toggle.thinking")
+    await wait((text) => !text.includes("HIDDEN OLD THOUGHT"))
+    events.emit({
+      directory,
+      payload: {
+        id: "evt_pivo_stream",
+        type: "message.part.updated",
+        properties: {
+          sessionID,
+          time: 4,
+          part: { ...parts[2], text: "**NEW STREAMED THOUGHT**\n\nUpdated reasoning" },
+        },
+      },
+    })
+    await Bun.sleep(30)
+    const updated = await frame()
+    expect(updated).not.toContain("NEW STREAMED THOUGHT")
+    expect(updated).toContain("VISIBLE AFTER")
+    api!.keymap.dispatchCommand("session.toggle.thinking")
+    await wait((text) => text.includes("NEW STREAMED THOUGHT"))
+    api!.keymap.dispatchCommand("session.toggle.thinking")
+    const tool = (
+      id: string,
+      name: string,
+      input: Record<string, unknown>,
+      metadata: Record<string, unknown> = {},
+    ): ToolPart => ({
+      id,
