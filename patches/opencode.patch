@@ -0,0 +1,63 @@
+import { createResource, For, onCleanup, Show } from "solid-js"
+import { TextAttributes } from "@opentui/core"
+import { useTheme } from "../context/theme"
+import { useDialog } from "../ui/dialog"
+import { subscriptionUsage } from "../util/subscription-usage"
+
+export function DialogUsage() {
+  const { theme } = useTheme()
+  const dialog = useDialog()
+  const controller = new AbortController()
+  onCleanup(() => controller.abort())
+  const [usage] = createResource(async () => {
+    return subscriptionUsage(controller.signal)
+      .then((data) => ({ data, error: undefined }))
+      .catch((error: unknown) => ({
+        data: undefined,
+        error: error instanceof Error ? error.message : "Не удалось получить лимиты.",
+      }))
+  })
+
+  return (
+    <box paddingLeft={2} paddingRight={2} paddingBottom={1} gap={1}>
+      <box flexDirection="row" justifyContent="space-between">
+        <text fg={theme.text} attributes={TextAttributes.BOLD}>
+          Лимиты ChatGPT / Codex
+        </text>
+        <text fg={theme.textMuted} onMouseUp={() => dialog.clear()}>
+          esc
+        </text>
+      </box>
+      <text fg={theme.textMuted}>Аккаунт OpenAI из локального OpenCode</text>
+      <Show when={usage.loading}>
+        <text fg={theme.textMuted}>Загружаю…</text>
+      </Show>
+      <Show when={usage()?.error}>{(error) => <text fg={theme.warning}>{error()}</text>}</Show>
+      <Show when={usage()?.data}>
+        {(data) => (
+          <>
+            <Show when={data().plan}>
+              <text fg={theme.text}>Подписка: {data().plan}</text>
+            </Show>
+            <For each={data().windows}>
+              {(window) => (
+                <box>
+                  <text fg={theme.text}>
+                    {window.label}: осталось {window.remaining.toLocaleString("ru-RU", { maximumFractionDigits: 1 })}%
+                  </text>
+                  <Show when={window.reset}>
+                    <text fg={theme.textMuted}>Сброс: {new Date(window.reset!).toLocaleString("ru-RU")}</text>
+                  </Show>
+                </box>
+              )}
+            </For>
+            <Show when={!data().windows.some((window) => window.label === "Неделя")}>
+              <text fg={theme.warning}>Недельный лимит не передан сервисом.</text>
+            </Show>
+            <text fg={theme.textMuted}>Лимит подписки — в процентах; остаток в токенах сервис не сообщает.</text>
+          </>
+        )}
+      </Show>
+    </box>
+  )
+}
