diff --git a/packages/tui/test/util/agent-duration.test.ts b/packages/tui/test/util/agent-duration.test.ts
new file mode 100644
index 0000000..4e53d9c
--- /dev/null
+++ b/packages/tui/test/util/agent-duration.test.ts
@@ -0,0 +1,78 @@
+import { describe, expect, test } from "bun:test"
+import type { AssistantMessage, Message } from "@opencode-ai/sdk/v2"
+import { agentDuration, agentRun } from "../../src/util/agent-duration"
+
+const assistant = (
+  id: string,
+  parentID: string,
+  created: number,
+  completed?: number,
+  finish?: string,
+): AssistantMessage => ({
+  id,
+  parentID,
+  sessionID: "session",
+  role: "assistant",
+  agent: "build",
+  mode: "build",
+  providerID: "test",
+  modelID: "test",
+  path: { cwd: "/tmp", root: "/tmp" },
+  cost: 0,
+  tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+  time: { created, completed },
+  finish,
+})
+
+describe("agent run duration", () => {
+  test("covers tool rounds and retries from the first assistant timestamp", () => {
+    const messages = [assistant("a", "u", 1000, 3000, "tool-calls"), assistant("b", "u", 4000)]
+    expect(agentRun(messages, { type: "busy" })).toMatchObject({ start: 1000, running: true })
+    expect(agentRun(messages, { type: "retry", attempt: 1, message: "retry", next: 8000 })?.running).toBe(true)
+  })
+  test("a queued user does not reset the active run or include queue waiting", () => {
+    const messages: Message[] = [
+      assistant("a", "u", 1000),
+      {
+        id: "queued",
+        sessionID: "session",
+        role: "user",
+        agent: "build",
+        model: { providerID: "test", modelID: "test" },
+        time: { created: 2000 },
+      },
+    ]
+    expect(agentRun(messages, { type: "busy" })?.start).toBe(1000)
+    messages.push(assistant("b", "queued", 9000))
+    expect(agentRun(messages, { type: "busy" })?.start).toBe(9000)
+  })
+  test("finished runs remain frozen on resume and before idle arrives", () => {
+    const messages = [assistant("a", "u", 1000, 3000, "tool-calls"), assistant("b", "u", 4000, 62000, "stop")]
+    expect(agentRun(messages, { type: "busy" })).toEqual({
+      start: 1000,
+      end: 62000,
+      running: false,
+      finished: true,
+      failed: false,
+    })
+    expect(agentRun(messages, { type: "idle" })).toEqual(agentRun(messages))
+  })
+  test("idle incomplete history never ticks as if it were still running", () => {
+    expect(agentRun([assistant("a", "u", 1000)], { type: "idle" })).toMatchObject({
+      running: false,
+      finished: false,
+      end: undefined,
+    })
+    expect(agentRun([], { type: "busy" })).toBeUndefined()
+  })
+  test("an interrupted run freezes its duration without being labelled successful", () => {
+    const message = assistant("a", "u", 1000, 4500)
+    message.error = { name: "MessageAbortedError", data: { message: "Aborted" } }
+    expect(agentRun([message], { type: "idle" })).toMatchObject({ end: 4500, running: false, failed: true })
+  })
+  test("formats long durations without a 24-hour wrap", () => {
+    expect(agentDuration(-1000)).toBe("0:00")
+    expect(agentDuration(61000)).toBe("1:01")
+    expect(agentDuration(90061000)).toBe("25:01:01")
+  })
+})
diff --git a/packages/tui/test/cli/tui/important-tools.test.ts b/packages/tui/test/cli/tui/important-tools.test.ts
new file mode 100644
index 0000000..bbd7310
--- /dev/null
+++ b/packages/tui/test/cli/tui/important-tools.test.ts
@@ -0,0 +1,87 @@
+import { expect, test } from "bun:test"
+import type { ToolPart } from "@opencode-ai/sdk/v2"
+import { importantTool, importantToolLabel } from "../../../src/util/important-tools"
+
+function tool(name: string, metadata: Record<string, unknown> = {}): ToolPart {
+  return {
+    id: "prt_tool",
+    sessionID: "ses_test",
+    messageID: "msg_test",
+    callID: "call_test",
+    type: "tool",
+    tool: name,
+    state: {
+      status: "completed",
+      input: {},
+      output: "long output",
+      title: "Tool result",
+      metadata,
+      time: { start: 1, end: 2 },
+    },
+  }
+}
+
+test("important filter keeps mutations, terminal commands, questions and unknown tools", () => {
+  for (const name of [
+    "bash",
+    "edit",
+    "write",
+    "apply_patch",
+    "question",
+    "gitlab_create_merge_request",
+    "github_pull_request_review_write",
+    "custom_read_and_delete",
+    "unknown_tool",
+  ])
+    expect(importantTool(tool(name))).toBe(true)
+  for (const name of [
+    "read",
+    "glob",
+    "grep",
+    "skill",
+    "todowrite",
+    "context7_context7_query-docs",
+    "gitlab_get_merge_request",
+    "github_pull_request_read",
+  ])
+    expect(importantTool(tool(name))).toBe(false)
+})
+
+test("routine failures stay visible, including execution metadata failures", () => {
+  const failed = tool("read")
+  failed.state = { status: "error", error: "Permission denied", input: {}, time: { start: 1, end: 2 } }
+  expect(importantTool(failed)).toBe(true)
+  expect(importantToolLabel(failed)).toContain("Ошибка")
+  expect(importantTool(tool("execute", { error: true, toolCalls: [{ tool: "read", status: "completed" }] }))).toBe(true)
+  expect(importantTool(tool("execute", { toolCalls: [{ tool: "read", status: "error" }] }))).toBe(true)
+})
+
+test("read-only execution groups disappear while mixed groups keep a compact mutation label", () => {
+  expect(
+    importantTool(
+      tool("execute", {
+        toolCalls: [
+          { tool: "read", status: "completed" },
+          { tool: "grep", status: "completed" },
+        ],
+      }),
+    ),
+  ).toBe(false)
+  const mixed = tool("execute", {
+    toolCalls: [
+      { tool: "read", status: "completed" },
+      { tool: "apply_patch", status: "completed" },
+    ],
+  })
+  expect(importantTool(mixed)).toBe(true)
+  expect(importantToolLabel(mixed)).toBe("apply_patch")
+})
+
+test("compact label does not leak full output, diff, or multiline input", () => {
+  const part = tool("bash")
+  part.state.input = { description: "Build\n" + "x".repeat(300), command: "very long shell command" }
+  const label = importantToolLabel(part)
+  expect(label.length).toBeLessThanOrEqual(120)
+  expect(label).not.toContain("\n")
+  expect(label).not.toContain("long output")
+})
