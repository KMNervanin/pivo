index 0000000..e268c34
--- /dev/null
+++ b/packages/tui/src/component/agent-timer.tsx
@@ -0,0 +1,38 @@
+import { createEffect, createMemo, createSignal, onCleanup, Show } from "solid-js"
+import { useSync } from "../context/sync"
+import { useTheme } from "../context/theme"
+import { agentDuration, agentRun } from "../util/agent-duration"
+
+export function AgentTimer(props: { sessionID: string }) {
+  const sync = useSync()
+  const { theme } = useTheme()
+  const run = createMemo(() =>
+    agentRun(sync.data.message[props.sessionID] ?? [], sync.data.session_status[props.sessionID]),
+  )
+  const [now, setNow] = createSignal(Date.now())
+  createEffect(() => {
+    if (!run()?.running) return
+    setNow(Date.now())
+    const timer = setInterval(() => setNow(Date.now()), 1000)
+    onCleanup(() => clearInterval(timer))
+  })
+  const duration = () => {
+    const value = run()
+    if (!value) return "—"
+    const end = value.running ? now() : value.end
+    if (end === undefined) return "—"
+    return `${!value.running && !value.finished ? "≥ " : ""}${agentDuration(end - value.start)}`
+  }
+  return (
+    <Show when={run()}>
+      <box id="pivo-agent-timer" flexShrink={0}>
+        <text fg={theme.text}>
+          <b>Время агента</b>
+        </text>
+        <text fg={run()?.running ? theme.accent : theme.textMuted}>
+          {run()?.running ? "Работает" : run()?.finished && !run()?.failed ? "Завершено" : "Остановлен"} · {duration()}
+        </text>
+      </box>
+    </Show>
+  )
+}
