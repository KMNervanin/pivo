+import { expect, test } from "bun:test"
+
+test("pivo renders thoughts, important tools and Cmd+Enter without losing queued messages", async () => {
+  // Native renderer and keyboard state must not leak into other renderer tests.
+  const child = Bun.spawn([process.execPath, "./test/fixture/pivo-render-check.tsx"], {
+    stdout: "pipe",
+    stderr: "pipe",
+  })
+  const timer = setTimeout(() => child.kill(), 20000)
+  try {
+    const [exitCode, stdout, stderr] = await Promise.all([
+      child.exited,
+      new Response(child.stdout).text(),
+      new Response(child.stderr).text(),
+    ])
+    expect(exitCode, stdout + stderr).toBe(0)
+  } finally {
+    clearTimeout(timer)
+  }
+}, 25000)
+
+test("pivo can scroll to the beginning after hydration and 120 new replies", async () => {
+  const child = Bun.spawn([process.execPath, "./test/fixture/pivo-render-check.tsx"], {
+    env: { ...process.env, PIVO_HISTORY_CHECK: "1" },
+    stdout: "pipe",
+    stderr: "pipe",
+  })
+  const timer = setTimeout(() => child.kill(), 20000)
+  try {
+    const [exit, stdout, stderr] = await Promise.all([
+      child.exited,
+      new Response(child.stdout).text(),
+      new Response(child.stderr).text(),
+    ])
+    expect(exit, stdout + stderr).toBe(0)
+  } finally {
+    clearTimeout(timer)
+  }
+}, 25000)
