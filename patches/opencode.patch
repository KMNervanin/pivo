index 0000000..bb5a401
--- /dev/null
+++ b/packages/tui/src/component/dialog-content-width.tsx
@@ -0,0 +1,74 @@
+import { SliderRenderable, TextAttributes } from "@opentui/core"
+import { extend, useTerminalDimensions } from "@opentui/solid"
+import { For, onCleanup } from "solid-js"
+import { useTheme } from "../context/theme"
+import { useContentWidth } from "../context/content-width"
+import { useDialog } from "../ui/dialog"
+import { useBindings } from "../keymap"
+
+declare module "@opentui/solid" {
+  interface OpenTUIComponents {
+    pivo_width_slider: typeof SliderRenderable
+  }
+}
+extend({ pivo_width_slider: SliderRenderable })
+
+export function DialogContentWidth() {
+  const { theme } = useTheme()
+  const dialog = useDialog()
+  const width = useContentWidth()
+  const dimensions = useTerminalDimensions()
+  width.preview(width.value())
+  onCleanup(() => width.save())
+  useBindings(() => ({
+    bindings: [
+      { key: "left", cmd: () => width.preview(width.value() - 5) },
+      { key: "right", cmd: () => width.preview(width.value() + 5) },
+      { key: "home", cmd: () => width.preview(40) },
+      { key: "end", cmd: () => width.preview(100) },
+      { key: "return", cmd: () => dialog.clear() },
+    ],
+  }))
+
+  return (
+    <box paddingLeft={2} paddingRight={2} paddingBottom={1} gap={1}>
+      <box flexDirection="row" justifyContent="space-between">
+        <text fg={theme.text} attributes={TextAttributes.BOLD}>
+          Ширина чата · {width.value()}%
+        </text>
+        <text fg={theme.textMuted} onMouseUp={() => dialog.clear()}>
+          esc
+        </text>
+      </box>
+      <text fg={theme.textMuted}>Перетащи ползунок или нажимай ← →. Окно терминала не меняется.</text>
+      <pivo_width_slider
+        id="pivo-width-slider"
+        orientation="horizontal"
+        min={40}
+        max={100}
+        value={width.value()}
+        viewPortSize={5}
+        width="100%"
+        height={2}
+        backgroundColor={theme.backgroundElement}
+        foregroundColor={theme.primary}
+        on:change={(event: { value: number }) => width.preview(event.value)}
+      />
+      <box flexDirection="row" justifyContent="space-between">
+        <text fg={theme.textMuted}>40%</text>
+        <text fg={theme.textMuted}>100%</text>
+      </box>
+      <box flexDirection="row" gap={3}>
+        <For each={[60, 80, 100]}>
+          {(value) => (
+            <text fg={theme.primary} onMouseUp={() => width.preview(value)}>
+              [{value}%]
+            </text>
+          )}
+        </For>
+      </box>
+      <text fg={theme.textMuted}>Чат и ввод по центру. Минимум 40 колонок; сейчас окно {dimensions().width}.</text>
+      <text fg={theme.textMuted}>Enter / Esc — закрыть и сохранить</text>
+    </box>
+  )
+}
diff --git a/packages/tui/src/component/dialog-subagents.tsx b/packages/tui/src/component/dialog-subagents.tsx
new file mode 100644
index 0000000..c58da8b
--- /dev/null
+++ b/packages/tui/src/component/dialog-subagents.tsx
@@ -0,0 +1,224 @@
+import { createMemo, createResource, createSignal, onCleanup } from "solid-js"
+import type { Agent, AssistantMessage } from "@opencode-ai/sdk/v2"
+import { DialogSelect } from "../ui/dialog-select"
+import { DialogPrompt } from "../ui/dialog-prompt"
+import { useDialog } from "../ui/dialog"
+import { useSDK } from "../context/sdk"
+import { useSync } from "../context/sync"
+import { useLocal } from "../context/local"
+import { useRoute } from "../context/route"
+import { useTheme } from "../context/theme"
+import { useToast } from "../ui/toast"
+import { errorMessage } from "../util/error"
+
+export function DialogSubagents(props: { sessionID?: string }) {
+  const sdk = useSDK()
+  const sync = useSync()
+  const dialog = useDialog()
+  const route = useRoute()
+  const { theme } = useTheme()
+  const [error, setError] = createSignal<string>()
+  const [items, { refetch }] = createResource(
+    () =>
+      props.sessionID &&
+      [
+        props.sessionID,
+        ...sync.data.session.filter((s) => s.parentID === props.sessionID).map((s) => `${s.id}:${s.time.updated}`),
+        ...Object.entries(sync.data.session_status).map(([id, status]) => `${id}:${status.type}`),
+      ].join("|"),
+    async () => {
+      setError(undefined)
+      try {
+        const response = await sdk.client.session.children({ sessionID: props.sessionID! }, { throwOnError: true })
+        return await Promise.all(
+          (response.data ?? [])
+            .filter((child) => !child.time.archived)
+            .map(async (session) => {
+              const messages = await sdk.client.session
+                .messages({ sessionID: session.id, limit: 1 }, { throwOnError: true })
+                .catch(() => undefined)
+              return { session, last: messages?.data?.at(-1)?.info, known: messages !== undefined }
+            }),
+        )
+      } catch (cause) {
+        setError(errorMessage(cause))
+        return []
+      }
+    },
+  )
+  const agents = createMemo(() => sync.data.agent.filter((agent) => !agent.hidden && agent.mode !== "primary"))
+  const rows = createMemo(() =>
+    (items() ?? []).map((item) => {
+      const status = sync.data.session_status[item.session.id]?.type
+      const attention =
+        (sync.data.permission[item.session.id]?.length ?? 0) + (sync.data.question[item.session.id]?.length ?? 0)
+      const label = attention
+        ? "Ждёт тебя"
+        : status === "retry"
+          ? "Повтор"
+          : status === "busy"
+            ? "Работает"
+            : childStatus(item.last, item.known)
+      return {
+        value: item.session.id,
+        title: item.session.title,
+        description: label,
+        category: attention || status === "busy" || status === "retry" ? "Активные" : "Остальные",
+      }
+    }),
+  )
+
+  return (
+    <DialogSelect
+      title={`Сабагенты${rows().length ? ` · ${rows().length}` : ""}`}
+      placeholder="Найти задачу…"
+      options={[
+        {
+          value: "new",
+          title: "+ Запустить сабагента",
+          description: "Выбрать роль и задать задачу",
+          disabled: !agents().length,
+        },
+        ...rows(),
+        ...(props.sessionID ? [{ value: props.sessionID, title: "← Родительская сессия", category: "Навигация" }] : []),
+        { value: "refresh", title: "↻ Обновить", category: "Навигация" },
+      ]}
+      footer={
+        <text fg={error() ? theme.error : theme.textMuted}>
+          {error() ??
+            (items.loading
+              ? "Загружаю…"
+              : rows().length
+                ? "Enter — открыть переписку и результат"
+                : "Дочерних задач пока нет")}
+        </text>
+      }
+      onSelect={(option) => {
+        if (option.value === "refresh") {
+          void refetch()
+          return
+        }
+        if (option.value === "new") {
+          dialog.replace(() => (
+            <DialogSelect
+              title="Выбери сабагента"
+              options={agents().map((agent) => ({ value: agent, title: agent.name, description: agent.description }))}
+              onSelect={(option) =>
+                dialog.replace(() => <SubagentPrompt parentID={props.sessionID} agent={option.value} />)
+              }
+            />
+          ))
+          return
+        }
+        dialog.clear()
+        route.navigate({ type: "session", sessionID: option.value })
+      }}
+    />
+  )
+}
+
+export function childStatus(
+  last: { role: string; time: { created: number; completed?: number }; error?: AssistantMessage["error"] } | undefined,
+  known: boolean,
+) {
+  if (!known) return "Статус неизвестен"
+  if (!last) return "Не запускался"
+  if (last.error?.name === "MessageAbortedError") return "Прерван"
+  if (last.error) return "Ошибка"
+  if (last.role === "assistant" && last.time.completed) return "Готов"
+  return "В очереди"
+}
+
+function SubagentPrompt(props: { parentID?: string; agent: Agent }) {
+  const sdk = useSDK()
+  const sync = useSync()
+  const local = useLocal()
+  const dialog = useDialog()
+  const route = useRoute()
+  const toast = useToast()
+  const { theme } = useTheme()
+  const [busy, setBusy] = createSignal(false)
+  const [error, setError] = createSignal<string>()
+  let parentID = props.parentID
+  let active = true
+  onCleanup(() => {
+    active = false
+  })
+
+  async function launch(text: string) {
+    if (!text.trim() || busy()) return
+    const model = local.model.current()
+    const parentAgent = local.agent.current()
+    if (!model || !parentAgent) {
+      setError("Сначала выбери модель и основного агента")
+      return
+    }
+    setBusy(true)
+    setError(undefined)
+    try {
+      if (!parentID) {
+        const created = await sdk.client.session.create(
+          {
+            title: "Задачи сабагентов",
+            agent: parentAgent.name,
+            model: { providerID: model.providerID, id: model.modelID },
+          },
+          { throwOnError: true },
+        )
+        parentID = created.data.id
+      }
+      const parent = sync.session.get(parentID)
+      await sdk.client.session.promptAsync(
+        {
+          sessionID: parentID,
+          directory: parent?.directory,
+          workspace: parent?.workspaceID,
+          agent: parentAgent.name,
+          model,
+          variant: local.model.variant.current(),
+          parts: [
+            { type: "text", text: `@${props.agent.name}\n${text.trim()}` },
+            {
+              type: "subtask",
+              agent: props.agent.name,
+              description: text.trim().split("\n")[0].slice(0, 80),
+              prompt: text.trim(),
+              model: props.agent.model ?? model,
+            },
+          ],
+        },
+        { throwOnError: true },
+      )
+      if (active) {
+        dialog.clear()
+        route.navigate({ type: "session", sessionID: parentID })
+      }
+      toast.show({
+        message: `Задача для ${props.agent.name} передана; результат вернётся в родительскую сессию`,
+        variant: "info",
+      })
+    } catch (cause) {
+      setError(errorMessage(cause))
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  return (
+    <DialogPrompt
+      title={`Задача для ${props.agent.name}`}
+      placeholder="Опиши задачу…"
+      description={() => (
+        <text fg={error() ? theme.error : theme.textMuted}>
+          {error() ??
+            "Штатный task: права сабагента сохраняются, результат вернётся родителю. Если он занят, задача встанет в очередь."}
+        </text>
+      )}
+      busy={busy()}
+      busyText="Передаю задачу…"
+      onConfirm={(text) => {
+        void launch(text)
+      }}
+    />
+  )
+}
diff --git a/packages/tui/src/component/dialog-usage.tsx b/packages/tui/src/component/dialog-usage.tsx
