    "textMuted": { "dark": "muted", "light": "mutedLight" },
    "selectedListItemText": { "dark": "#191918", "light": "paper" },
    "background": { "dark": "dark", "light": "paper" },
    "backgroundPanel": { "dark": "panel", "light": "#f0eee6" },
    "backgroundElement": { "dark": "element", "light": "#e7e4da" },
