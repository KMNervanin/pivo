    "markdownImageText": { "dark": "blue", "light": "orangeLight" },
    "markdownCodeBlock": { "dark": "paper", "light": "ink" },
    "syntaxComment": { "dark": "muted", "light": "mutedLight" },
    "syntaxKeyword": { "dark": "#c1a3c9", "light": "#795583" },
    "syntaxFunction": { "dark": "blue", "light": "orangeLight" },
    "syntaxVariable": { "dark": "paper", "light": "ink" },
    "syntaxString": { "dark": "green", "light": "#577136" },
    "syntaxNumber": { "dark": "#e8bb9e", "light": "#955331" },
