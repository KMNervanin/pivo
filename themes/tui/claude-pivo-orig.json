{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "orange": "#d97757",
    "orangeLight": "#b75436",
    "dark": "#262624",
    "panel": "#30302e",
    "element": "#3a3935",
    "paper": "#faf9f5",
    "ink": "#3d3d3a",
    "muted": "#aaa69d",
    "mutedLight": "#706d65",
    "blue": "#d97757",
    "green": "#a5b58a",
    "red": "#dc8b83",
    "yellow": "#d9ba7a"
  },
  "theme": {
    "primary": { "dark": "orange", "light": "orangeLight" },
    "secondary": { "dark": "blue", "light": "orangeLight" },
    "accent": { "dark": "orange", "light": "orangeLight" },
    "error": { "dark": "red", "light": "#b3423c" },
    "warning": { "dark": "yellow", "light": "#88681b" },
    "success": { "dark": "green", "light": "#577136" },
