    "markdownStrong": { "dark": "paper", "light": "ink" },
    "markdownHorizontalRule": { "dark": "#59574f", "light": "#c6c1b5" },
    "markdownListItem": { "dark": "orange", "light": "orangeLight" },
    "markdownListEnumeration": { "dark": "orange", "light": "orangeLight" },
